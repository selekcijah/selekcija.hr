            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "body": {
          "type": "StructuredText",
          "config": {
            "label": "Body",
            "placeholder": "Add full-width service details",
            "allowTargetBlank": true,
            "multi": "paragraph,heading3,heading4,strong,em,hyperlink,image,list-item,o-list-item,heading1,heading2,heading5,heading6,preformatted"
          }
        }
      },
      "items": {}
    }
  ]
}