{
  "id": "content_slice",
  "type": "SharedSlice",
  "name": "ContentSlice",
  "description": "Full-width rich content section",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Full-width content section",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "placeholder": "End-to-end Permanent Placement",
